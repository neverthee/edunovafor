# Copy to /home/admin/project/edunova/backend/.env on the server and fill real values there.
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
CORS_ORIGINS=https://example.com,https://www.example.com

LLM_API_KEY=replace-with-your-provider-key
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_TEXT_PRIMARY=qwen-flash
MODEL_TEXT_FALLBACKS=qwen3.5-flash,qwen3.6-plus
MODEL_EMBEDDING_PRIMARY=text-embedding-v4
MODEL_EMBEDDING_FALLBACKS=text-embedding-v3
MODEL_RERANK_PRIMARY=qwen3-rerank
MODEL_RERANK_FALLBACKS=gte-rerank-v2
MODEL_OCR_PRIMARY=qwen-vl-ocr-latest
MODEL_OCR_FALLBACKS=qwen-vl-ocr,qwen3-vl-flash
MODEL_ASR_PRIMARY=qwen3-asr-flash-realtime
MODEL_ASR_FALLBACKS=qwen3-asr-flash-filetrans,fun-asr-realtime

# On Ubuntu this is usually found automatically after installing libreoffice.
# Set it only if soffice/libreoffice is not on PATH.
# SOFFICE_PATH=/usr/bin/soffice
